{
    "name": "@ptrn/icons",
    "version": "0.0.1",
    "license": "CC-BY-4.0",
    "files": [
        "*.js",
        "*.d.ts",
        "*.svg",
        "SvgIcon",
        "meta",
        "README.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "main": "index.js",
    "type": "module",
    "scripts": {
        "clean": "rm -rf ./*.js ./*.d.ts ./*svg ./src ./meta ./SvgIcon && mkdir -p src && touch ./src/index.ts",
        "build": "tsx .scripts/build.ts",
        "build:material": "tsx .scripts/build-material.ts",
        "pack": "npm run build && npm pack && npm run clean && mkdir -p src && touch ./src/index.ts && tar -xvf *.tgz",
        "build:nowhere": "tsx .scripts/build-nowhere.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pttrn/pttrn",
        "directory": "packages/icons"
    },
    "engines": {
        "node": ">=22"
    },
    "peerDependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@svgr/core": "^8.1.0",
        "@svgr/plugin-jsx": "^8.1.0",
        "@types/node": "^22.15.17",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "prettier": "^3.3.3",
        "svgo": "^3.3.2",
        "tsx": "^4.20.5",
        "typescript": "^5.6.3"
    }
}
